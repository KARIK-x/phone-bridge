BACKEND=telegram
PORT=3000

# Telegram
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Security
ALLOWED_CHAT_ID=
PAIR_TOKEN=change-me-to-a-long-random-string

# HTTP
HTTP_TIMEOUT=20

# tmux / OpenCode
TMUX_SESSION=ai-bridge
OPENCODE_CMD=opencode
OPENCODE_WORKDIR=
POLL_MS=1500
DEBOUNCE_MS=2500
COMPLETION_DEBOUNCE_MS=4000
TAIL_DEFAULT=30
CAPTURE_LINES=500

# Notifications
NOTIFY_ON_START=true
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_FAIL=true
NOTIFY_ON_PERMISSION=true
NOTIFY_ON_RESTART=true
NOTIFY_TAIL_LINES=15

# Detection patterns (comma-separated regex)
PERMISSION_PATTERNS=(?i)(approve|allow|permission|grant access|\(y/n\)|y/n|press enter|run this)
ERROR_PATTERNS=(?i)(traceback|panic:|error:|fatal:|command not found|exception)
